// OpticalFlow sensor message for DDS transport

#include "std_msgs/msg/Header.idl"
#include "geometry_msgs/msg/Vector3.idl"

module ardupilot_msgs {
  module msg {
    @verbatim(language = "comment", text = "OpticalFlow sensor data")
    struct OpticalFlow {
      std_msgs::msg::Header header;
      uint8 instance_id;
      geometry_msgs::msg::Vector3 flow_rate;
      geometry_msgs::msg::Vector3 body_rate;
      uint8 quality;
      boolean healthy;
    };
  };
};
