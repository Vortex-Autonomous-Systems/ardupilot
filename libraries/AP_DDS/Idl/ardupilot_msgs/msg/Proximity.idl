// Proximity sensor message for DDS transport

#include "std_msgs/msg/Header.idl"

module ardupilot_msgs {
  module msg {
    @verbatim(language = "comment", text = "Proximity sensor data - multi-sector")
    struct Proximity {
      std_msgs::msg::Header header;
      uint8 instance_id;
      float distances[72];
      float angle_offset;
      float angle_width;
      float min_distance_m;
      float max_distance_m;
      uint8 num_sectors;
      uint8 status;
    };
  };
};
