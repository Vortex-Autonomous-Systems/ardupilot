// Magnetometer sensor message for DDS transport

#include "std_msgs/msg/Header.idl"
#include "geometry_msgs/msg/Vector3.idl"

module ardupilot_msgs {
  module msg {
    @verbatim(language = "comment", text = "Magnetometer sensor data")
    struct Magnetometer {
      std_msgs::msg::Header header;
      uint8 instance_id;
      geometry_msgs::msg::Vector3 field;
      geometry_msgs::msg::Vector3 offsets;
      float declination_deg;
      boolean healthy;
      boolean calibrating;
      boolean is_primary;
    };
  };
};
